* text=auto

# 与.editorconfig保持一致，跨Windows/Linux构建时统一使用LF
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.txt text eol=lf
*.vue text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Android文字辅助组件的源码清单按字节校验，跨平台检出保持一致
src-tauri/resources/remote-input/**/*.java text eol=lf
src-tauri/resources/remote-input/*.sha256 text eol=lf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
