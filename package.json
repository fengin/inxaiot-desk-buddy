{
  "name": "inxaiot-desk-buddy",
  "version": "0.2.8",
  "private": true,
  "description": "INX 实施工作台桌面应用",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:desktop:screen": "node scripts/dev-screen-desktop.mjs",
    "build": "vue-tsc -b --noEmit && vite build",
    "build:windows": "node scripts/build-windows.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --noEmit",
    "typecheck:screen": "vue-tsc -p tsconfig.screen-prototype.json --noEmit",
    "test:screen": "vitest run src/features/smart-screen src/test/productionAdapterIsolation.spec.ts",
    "test": "vitest run && node --test scripts/screen-tool-platform.test.mjs scripts/build-macos.test.mjs scripts/build-windows.test.mjs scripts/package-screen-tools.test.mjs",
    "test:watch": "vitest",
    "test:e2e:stage75a": "node ./test/e2e/stage75a-ui.mjs",
    "build:e2e:stage75a": "tauri build --debug --no-bundle --features desktop-e2e --config ./src-tauri/tauri.stage75a.conf.json",
    "test:e2e:stage75b": "node ./test/e2e/stage75a-ui.mjs",
    "build:e2e:stage75b": "tauri build --debug --no-bundle --features desktop-e2e --config ./src-tauri/tauri.stage75b.conf.json",
    "test:e2e:stage75d": "node ./test/e2e/stage75d-ui.mjs",
    "build:e2e:stage75d": "tauri build --debug --no-bundle --features desktop-e2e --config ./src-tauri/tauri.stage75d.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-vue-next": "0.577.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@unocss/vite": "66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.0.1",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "unocss": "66.7.5",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8",
    "webdriverio": "9.29.1"
  }
}
